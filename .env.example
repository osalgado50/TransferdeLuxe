NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_MODO_DEMO=true
DEMO_PASSWORD=

# Secreto para GET /api/demo/reset (cron diario de la demo): openssl rand -hex 32
CRON_SECRET=

# Consulta automática de vuelos (AeroDataBox vía RapidAPI). Opcional: sin clave, el botón no aparece.
AERODATABOX_API_KEY=

# Búsqueda de direcciones con Google Places API (New): Autocomplete + Place Details. Opcional y DE PAGO por uso.
# Sin clave (lo normal) no se usa ni aparece: la búsqueda es Photon (OpenStreetMap) con Nominatim de respaldo.
# Si se activa: restringe la clave a «Places API (New)» y pon un tope de gasto en Google Cloud.
GOOGLE_PLACES_API_KEY=
