{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "movil-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8089"
      ],
      "cwd": "movil",
      "port": 8089
    },
    {
      "name": "web-sin-vigilante",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VIGILANTE_PUSH=off",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001
    }
  ]
}
