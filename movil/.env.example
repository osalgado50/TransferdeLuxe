# Copia este fichero a movil/.env (ignorado por git) y rellena los valores.
# Solo la URL y la clave ANÓNIMA de Supabase (nunca la service role).
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima
EXPO_PUBLIC_API_URL=https://app.transfersvipluxe.com
# Modo demo: muestra el recuadro «Cuentas de demo» en el login con la contraseña pública de demo.
EXPO_PUBLIC_MODO_DEMO=false
EXPO_PUBLIC_DEMO_PASSWORD=
